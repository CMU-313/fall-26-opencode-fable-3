+const MAX_COPY_SEGMENTS = 5
+
+// Keep long paths readable: first folder, an ellipsis, then parent/file.
+function compactPath(path: string) {
+  const parts = path.split("/")
+  if (parts.length <= MAX_COPY_SEGMENTS) return path
+  return [parts[0], "…", ...parts.slice(-2)].join("/")
+}
