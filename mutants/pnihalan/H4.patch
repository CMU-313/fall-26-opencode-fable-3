   return `## Assistant (${Locale.titlecase(msg.agent)} · ${modelName}${duration ? ` · ${duration}` : ""})\n\n`
 }
 
+const formattedParts = new Map<string, string>()
+
 export function formatPart(part: Part, options: TranscriptOptions): string {
+  const key = `${part.messageID}/${part.id}`
+  const cached = formattedParts.get(key)
+  if (cached !== undefined) return cached
+  const result = renderPart(part, options)
+  formattedParts.set(key, result)
+  return result
+}
+
+function renderPart(part: Part, options: TranscriptOptions): string {
   if (part.type === "text" && !part.synthetic) {
     return `${part.text}\n\n`
   }
